# Telegram bot token from @BotFather  (Vercel → Project → Settings → Environment Variables)
TELEGRAM_BOT_TOKEN=

# Optional
# PUBLIC_URL=https://saavnx.vercel.app     # force the public URL (defaults to Vercel's production URL, then saavnx.vercel.app)
# TELEGRAM_BOT_USERNAME=SaavnxBot          # skip the one-time getMe lookup
